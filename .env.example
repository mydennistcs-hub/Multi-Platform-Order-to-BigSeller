# 複製這份檔案為 .env，填入實際值。.env 不會被 git 追蹤（見 .gitignore）。
# 這份 .env 是給單帳戶測試腳本（test_coupang_api.py / test_momo_api.py）用的；
# 正式的 App（app.py）走多帳戶設定，見 accounts.example.json。

# --- Coupang Open API（Wing → Open API Key 發行頁面取得）---
COUPANG_VENDOR_ID=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# 以下有預設值，通常不用改
# COUPANG_BASE_URL=https://api-gateway.coupang.com
# COUPANG_MARKET=TW

# --- momo店+ Vendor API（後台 A103 IP位址申請/查詢 → 寄送Token）---
MOMO_TOKEN=
# MOMO_BASE_URL=https://api3p.momo.com.tw
